@Composable
fun AppDetailScreen(pkg: String, onBack: () -> Unit) {
    val context = LocalContext.current
    val app = Repository.byPkg(pkg)
    LazyColumn(Modifier.fillMaxSize().background(Color.White)) {
        if (app == null) {
            item {
                BackRow(onBack)
                Text("Приложение не найдено", modifier = Modifier.padding(16.dp))
            }
        } else {
            item { BackRow(onBack) }
            item { HeaderBlock(app) { openInPlay(context, app.playPackage) } }
            item { MetaRow(app) }
            item { SectionTitle("Предпросмотр") }
            item { ScreenshotsRow(app) }
            item { DescriptionBlock(app) }
            item { RatingsBlock(app) }
            item { InfoBlock(app) }
            item { Spacer(Modifier.height(24.dp)) }
        }
    }
}

@Composable
private fun BackRow(onBack: () -> Unit) {
    Row(
        Modifier.clickable(onClick = onBack).padding(horizontal = 12.dp, vertical = 10.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Icon(Icons.AutoMirrored.Filled.ArrowBack, null, tint = Blue,
            modifier = Modifier.size(22.dp))
        Text("Назад", color = Blue, fontSize = 17.sp)
    }
}

@Composable
private fun HeaderBlock(app: AppItem, onGet: () -> Unit) {
    Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp),
        verticalAlignment = Alignment.CenterVertically) {
        AppIcon(app, 110.dp)
        Column(Modifier.weight(1f).padding(start = 16.dp),
            horizontalAlignment = Alignment.CenterHorizontally) {
            Text(app.name, fontSize = 22.sp, fontWeight = FontWeight.Bold,
                maxLines = 1, overflow = TextOverflow.Ellipsis)
            Text(app.developer, fontSize = 14.sp, color = Blue)
            Spacer(Modifier.height(12.dp))
            GetButton(onClick = onGet)
            Spacer(Modifier.height(4.dp))
            Text("Встроенные покупки", fontSize = 11.sp, color = GrayText)
        }
    }
}

@Composable
private fun StarsRow(n: Int, size: Dp = 12.dp) {
    Row {
        repeat(5) { i ->
            Icon(if (i < n) Icons.Filled.Star else Icons.Outlined.Star,
                null, tint = Blue, modifier = Modifier.size(size))
        }
    }
}

@Composable
private fun MetaCell(top: String, bottom: String, modifier: Modifier = Modifier,
                     stars: Int = 0) {
    Column(modifier, horizontalAlignment = Alignment.CenterHorizontally) {
        Text(top, fontSize = 20.sp, fontWeight = FontWeight.Medium)
        Spacer(Modifier.height(4.dp))
        if (stars > 0) StarsRow(stars) else Spacer(Modifier.height(16.dp))
        Spacer(Modifier.height(2.dp))
        Text(bottom, fontSize = 12.sp, color = GrayText, textAlign = TextAlign.Center,
            maxLines = 1)
    }
}

@Composable
private fun MetaRow(app: AppItem) {
    Row(Modifier.fillMaxWidth().padding(vertical = 16.dp),
        verticalAlignment = Alignment.CenterVertically) {
        MetaCell(fmtRating(app.rating), app.ratingCount, Modifier.weight(1f),
            app.rating.roundToInt())
        Box(Modifier.width(1.dp).height(44.dp).background(Separator))
        MetaCell(app.age, "Возраст", Modifier.weight(1f))
        Box(Modifier.width(1.dp).height(44.dp).background(Separator))
        MetaCell("Бесплатно", "Цена", Modifier.weight(1f))
    }
}

@Composable
private fun ScreenshotsRow(app: AppItem) {
    LazyRow(contentPadding = PaddingValues(horizontal = 16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp)) {
        items(3) {
            Box(
                Modifier
                    .width(200.dp)
                    .height(360.dp)
                    .clip(RoundedCornerShape(10.dp))
                    .background(Brush.verticalGradient(
                        listOf(app.color, app.color.darkened(0.6f)))),
                contentAlignment = Alignment.Center
            ) { Text(app.emoji, fontSize = 56.sp) }
        }
    }
}

@Composable
private fun DescriptionBlock(app: AppItem) {
    var expanded by rememberSaveable { mutableStateOf(false) }
    Column(Modifier.padding(16.dp)) {
        Text("Описание", fontSize = 20.sp, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(8.dp))
        Text(app.description, fontSize = 15.sp, lineHeight = 20.sp,
            maxLines = if (expanded) Int.MAX_VALUE else 3,
            overflow = TextOverflow.Ellipsis)
        Text(if (expanded) "свернуть" else "ещё", color = Blue, fontSize = 15.sp,
            modifier = Modifier.clickable { expanded = !expanded }.padding(top = 4.dp))
    }
}

private data class Review(val title: String, val stars: Int, val author: String, val text: String)
private val reviews = listOf(
    Review("Обожаю это приложение!", 5, "Мария К.", "Работает быстро, интерфейс понятный, пользуюсь каждый день."),
    Review("Почти идеально", 4, "Дмитрий П.", "Не хватает пары функций, но в целом всё нравится."),
    Review("Лучшее в своём жанре", 5, "Анна С.", "Перепробовала много аналогов — это лучший.")
)

@Composable
private fun RatingsBlock(app: AppItem) {
    Column(Modifier.padding(vertical = 8.dp)) {
        Text("Оценки и отзывы", fontSize = 20.sp, fontWeight = FontWeight.Bold,
            modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp))
        Row(Modifier.padding(horizontal = 16.dp),
            verticalAlignment = Alignment.CenterVertically) {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text(fmtRating(app.rating), fontSize = 44.sp, fontWeight = FontWeight.Bold)
                Text("из 5", fontSize = 12.sp, color = GrayText)
            }
            Spacer(Modifier.width(16.dp))
            Column {
                StarsRow(app.rating.roundToInt(), size = 14.dp)
                Spacer(Modifier.height(4.dp))
                Text(app.ratingCount, fontSize = 12.sp, color = GrayText)
            }
        }
        Spacer(Modifier.height(16.dp))
        LazyRow(contentPadding = PaddingValues(horizontal = 16.dp),
            horizontalArrangement = Arrangement.spacedBy(12.dp)) {
            items(reviews.size) { i ->
                val r = reviews[i]
                Column(
                    Modifier
                        .width(280.dp)
                        .clip(RoundedCornerShape(12.dp))
                        .background(Color(0xFFF2F2F7))
                        .padding(14.dp)
                ) {
                    Text(r.title, fontSize = 15.sp, fontWeight = FontWeight.SemiBold)
                    Spacer(Modifier.height(4.dp))
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        StarsRow(r.stars, size = 12.dp)
                        Spacer(Modifier.weight(1f))
                        Text(r.author, fontSize = 12.sp, color = GrayText)
                    }
                    Spacer(Modifier.height(8.dp))
                    Text(r.text, fontSize = 13.sp, color = Color(0xFF3C3C43))
                }
            }
        }
    }
}

@Composable
private fun InfoBlock(app: AppItem) {
    Column {
        Text("Информация", fontSize = 20.sp, fontWeight = FontWeight.Bold,
            modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp))
        listOf(
            "Категория" to app.category,
            "Размер" to app.size,
            "Совместимость" to "Android 8.0+",
            "Возраст" to app.age,
            "Цена" to "Бесплатно",
            "Встроенные покупки" to "Есть",
            "Разработчик" to app.developer
        ).forEach { (k, v) ->
            Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 10.dp)) {
                Text(k, fontSize = 15.sp, color = GrayText, modifier = Modifier.weight(1f))
                Text(v, fontSize = 15.sp)
            }
            Divider(color = Color(0xFFE5E5EA), modifier = Modifier.padding(horizontal = 16.dp))
        }
    }
}